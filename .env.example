# Server & Security Configuration (Template for Production / Render)
PORT=5000
JWT_SECRET=your_long_random_secret_here_min_32_chars
ALLOWED_ORIGINS=https://votre-site.onrender.com,http://localhost:5173

# Database Persistence (MongoDB Atlas) - REQUIRED IN PRODUCTION
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/autoledblida?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Cloud Media Storage (Cloudinary) - REQUIRED IN PRODUCTION
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Offline Development Flag ONLY (NEVER set to true on Render/Production!)
# When set to true, allows server to use local store.json and public/uploads if offline.
# USE_LOCAL_STORAGE=false

# Gmail SMTP for OTP Password Reset
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password